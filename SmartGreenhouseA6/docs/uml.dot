digraph SmartGreenhouse {
graph [layout=neato, overlap=true, splines=true, pad=0.12, bgcolor="white", outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans", fontsize=12, pin=true];
edge [color="#555555", fontcolor="#303030", fontname="DejaVu Sans", fontsize=11, arrowsize=0.8, penwidth=1.0];
Main [pos="125,1740!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+main(args)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">composition root</FONT></TD></TR></TABLE>>];
ProducerRunner [pos="420,1740!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>ProducerRunner</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-executor: ExecutorService</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+run(producers); +close()</FONT></TD></TR></TABLE>>];
ExecutorService [pos="745,1740!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;JDK interface&gt;&gt;</FONT><BR/><B>ExecutorService</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+submit(task); +shutdown()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+awaitTermination(...)</FONT></TD></TR></TABLE>>];
Event [pos="125,1605!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>Event</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+type(): EventType</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+zoneId(): String</FONT></TD></TR></TABLE>>];
EventType [pos="420,1605!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;enum&gt;&gt;</FONT><BR/><B>EventType</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">MOISTURE; TEMPERATURE</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">HUMIDITY; AVERAGE_MOISTURE</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">INSPECTION_REPORT</FONT></TD></TR></TABLE>>];
ReadingEvent [pos="680,1605!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;record&gt;&gt;</FONT><BR/><B>ReadingEvent</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">type, zoneId, value</FONT></TD></TR></TABLE>>];
AverageEvent [pos="900,1605!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;record&gt;&gt;</FONT><BR/><B>AverageEvent</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">zoneId, average, sampleCount</FONT></TD></TR></TABLE>>];
InspectionEvent [pos="900,1490!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;record&gt;&gt;</FONT><BR/><B>InspectionEvent</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">zoneId, deviceIds: List&lt;String&gt;</FONT></TD></TR></TABLE>>];
Subject [pos="250,1440!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>Subject&lt;E&gt;</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">E extends Event</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+subscribe(type, observer)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+unsubscribe(type, observer)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+publish(event: E)</FONT></TD></TR></TABLE>>];
Observer [pos="650,1440!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><FONT POINT-SIZE="11">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>Observer&lt;E&gt;</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">E extends Event</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+onEvent(event: E)</FONT></TD></TR></TABLE>>];
SimpleSubject [pos="125,1280!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>SimpleSubject&lt;E&gt;</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-listeners by EventType</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">CopyOnWriteArrayList</FONT></TD></TR></TABLE>>];
SoilSensor [pos="375,1280!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>SoilSensor</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Subject&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-events: Subject&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+moisture(zoneId, value)</FONT></TD></TR></TABLE>>];
WeatherStation [pos="625,1280!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>WeatherStation</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Subject&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-events: Subject&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+temperature(...); +humidity(...)</FONT></TD></TR></TABLE>>];
MoistureAggregator [pos="875,1280!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>MoistureAggregator</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Subject&lt;AverageEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-output: Subject&lt;AverageEvent&gt;</FONT></TD></TR></TABLE>>];
FarmerDashboard [pos="125,1150!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>FarmerDashboard</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-readings: ConcurrentMap</FONT></TD></TR></TABLE>>];
ReadingCounter [pos="375,1150!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>ReadingCounter</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-count: AtomicInteger</FONT></TD></TR></TABLE>>];
EventLog [pos="625,1150!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>EventLog</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-events: ConcurrentLinkedQueue</FONT></TD></TR></TABLE>>];
IrrigationController [pos="875,1150!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>IrrigationController</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-irrigationByZone: ConcurrentMap</FONT></TD></TR></TABLE>>];
FrostAlert [pos="125,1010!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>FrostAlert</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-alerts: ConcurrentLinkedQueue</FONT></TD></TR></TABLE>>];
InspectionService [pos="375,1010!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>InspectionService</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;ReadingEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-zones: Map&lt;String, Zone&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-inspector: Visitor&lt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">List&lt;GreenhouseElement&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-reports: Subject&lt;InspectionEvent&gt;</FONT></TD></TR></TABLE>>];
AverageDashboard [pos="625,1010!",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EEEEEE"><B>AverageDashboard</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">Observer&lt;AverageEvent&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-latest: ConcurrentHashMap</FONT></TD></TR></TABLE>>];
