classDiagram
direction TB

class Main {
  +main(args) void
  -createGreenhouse() Greenhouse
}
class ProducerRunner {
  -ExecutorService executor
  +run(producers) void
  +close() void
}
class ExecutorService {
  <<interface>>
  +submit(task) Future
  +shutdown() void
  +awaitTermination(timeout, unit) boolean
}
Main ..> ProducerRunner : creates and runs
ProducerRunner --> ExecutorService : owns lifecycle

class Event {
  <<interface>>
  +type() EventType
  +zoneId() String
}
class EventType {
  <<enumeration>>
  MOISTURE
  TEMPERATURE
  HUMIDITY
  AVERAGE_MOISTURE
  INSPECTION_REPORT
}
class ReadingEvent {
  <<record>>
  +EventType type
  +String zoneId
  +double value
}
class AverageEvent {
  <<record>>
  +String zoneId
  +double average
  +int sampleCount
}
class InspectionEvent {
  <<record>>
  +String zoneId
  +List~String~ deviceIds
}
Event <|.. ReadingEvent
Event <|.. AverageEvent
Event <|.. InspectionEvent
Event ..> EventType : type

class Subject~E~ {
  <<interface>>
  +subscribe(type, observer) void
  +unsubscribe(type, observer) void
  +publish(event) void
}
class Observer~E~ {
  <<interface>>
  +onEvent(event) void
}
note for Subject "E extends Event"
note for Observer "E extends Event"

class SimpleSubject~E~ {
  -Map listeners
  +subscribe(type, observer) void
  +unsubscribe(type, observer) void
  +publish(event) void
}
class SoilSensor {
  -Subject~ReadingEvent~ events
  +moisture(zoneId, value) void
}
class WeatherStation {
  -Subject~ReadingEvent~ events
  +temperature(zoneId, value) void
  +humidity(zoneId, value) void
}
class MoistureAggregator {
  -Map valuesByZone
  -Subject~AverageEvent~ output
  +onEvent(event) void
  +sampleCount(zoneId) int
  +average(zoneId) double
}
class FarmerDashboard {
  -ConcurrentMap readings
  +latest(type, zoneId) ReadingEvent
}
class ReadingCounter {
  -AtomicInteger count
  +count() int
}
class EventLog {
  -ConcurrentLinkedQueue events
  +events() List~ReadingEvent~
}
class IrrigationController {
  -double moistureThreshold
  -ConcurrentMap irrigationByZone
  +isIrrigationOn(zoneId) boolean
}
class FrostAlert {
  -double temperatureThreshold
  -ConcurrentLinkedQueue alerts
  +alerts() List~ReadingEvent~
}
class InspectionService {
  -Map zones
  -Visitor inspector
  -Subject~InspectionEvent~ reports
  -double dryThreshold
  +onEvent(event) void
}
class AverageDashboard {
  -ConcurrentHashMap latest
  +onEvent(event) void
  +latest(zoneId) AverageEvent
}
class ReportCollector {
  -ConcurrentLinkedQueue reports
  +onEvent(event) void
  +reports() List~InspectionEvent~
}

Subject <|.. SimpleSubject
Subject <|.. SoilSensor : E is ReadingEvent
Subject <|.. WeatherStation : E is ReadingEvent
Subject <|.. MoistureAggregator : E is AverageEvent
SoilSensor --> Subject : events delegate
WeatherStation --> Subject : events delegate
MoistureAggregator --> Subject : output delegate
SimpleSubject --> Observer : subscribers by EventType
Observer <|.. MoistureAggregator : ReadingEvent
Observer <|.. FarmerDashboard : ReadingEvent
Observer <|.. ReadingCounter : ReadingEvent
Observer <|.. EventLog : ReadingEvent
Observer <|.. IrrigationController : ReadingEvent
Observer <|.. FrostAlert : ReadingEvent
Observer <|.. InspectionService : ReadingEvent
Observer <|.. AverageDashboard : AverageEvent
Observer <|.. ReportCollector : InspectionEvent
Subject ..> Event : generic bound
Observer ..> Event : generic bound

